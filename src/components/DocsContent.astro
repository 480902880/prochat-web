---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const docsSubtitle = t('docs.sub');

const privacyItems = [
  ['docs.zero.title', 'docs.zero.desc'],
  ['docs.transport.title', 'docs.transport.desc'],
  ['docs.local.title', 'docs.local.desc'],
  ['docs.control.title', 'docs.control.desc'],
] as const;

const faqItems = [
  ['docs.faq1.q', 'docs.faq1.a'],
  ['docs.faq2.q', 'docs.faq2.a'],
] as const;
---

<main id="content" class="page docs-page">
  <div class="content-container">
    <header class="page-header reveal">
      <p class="eyebrow">{t('docs.eyebrow')}</p>
      <h1 class="page-title">{t('docs.title')}</h1>
      {docsSubtitle && <p class="page-subtitle">{docsSubtitle}</p>}
    </header>

    <div class="docs-flow">
      <section id="intro" class="docs-intro panel panel--elevated reveal">
        <h2>{t('docs.intro.title')}</h2>
        <p>{t('docs.intro.body')}</p>
      </section>

      <section id="privacy" class="reveal">
        <h2 class="section-title">
          <span class="section-marker" aria-hidden="true"></span>
          {t('docs.privacy.title')}
        </h2>
        <div class="privacy-grid">
          {privacyItems.map(([titleKey, descKey], index) => (
            <article class={`doc-card panel panel--border reveal reveal-delay-${Math.min(index + 1, 3)}`}>
              <h3>{t(titleKey)}</h3>
              <p>{t(descKey)}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="faq" class="reveal">
        <h2 class="section-title">
          <span class="section-marker" aria-hidden="true"></span>
          {t('docs.faq.title')}
        </h2>
        <div class="faq-list">
          {faqItems.map(([questionKey, answerKey], index) => (
            <article class={`faq-item panel panel--border reveal reveal-delay-${Math.min(index + 1, 3)}`}>
              <h3>{t(questionKey)}</h3>
              <p>{t(answerKey)}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</main>

<style>
  .docs-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .docs-intro {
    position: relative;
    padding: var(--space-8);
    overflow: hidden;
    animation: quiet-float var(--motion-loop) ease-in-out infinite;
  }

  .docs-intro::before {
    content: "";
    position: absolute;
    inset: 0;
    border-left: var(--space-1) solid var(--color-primary);
    pointer-events: none;
  }

  .docs-intro h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .docs-intro p {
    font-size: var(--text-base);
  }

  .privacy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .doc-card,
  .faq-item {
    position: relative;
    padding: var(--space-6);
    overflow: hidden;
    transition: transform var(--motion-base) ease, border-color var(--motion-base) ease, background-color var(--motion-base) ease;
  }

  .doc-card::before,
  .faq-item::before {
    content: "";
    position: absolute;
    top: var(--space-6);
    bottom: var(--space-6);
    left: 0;
    width: var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    opacity: 0;
    transition: opacity var(--motion-base) ease;
  }

  .doc-card:hover,
  .faq-item:hover {
    transform: translateY(calc(-1 * var(--space-1)));
    border-color: var(--color-neutral-300);
    background: var(--color-neutral-50);
  }

  .doc-card:hover::before,
  .faq-item:hover::before {
    opacity: 1;
  }

  .doc-card h3,
  .faq-item h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }

  .doc-card p,
  .faq-item p {
    font-size: var(--text-sm);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (max-width: 768px) {
    .privacy-grid {
      grid-template-columns: 1fr;
    }

    .docs-flow {
      gap: var(--space-12);
    }
  }
</style>
