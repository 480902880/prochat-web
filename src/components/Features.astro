---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  ['feat.local.title', 'feat.local.desc', 'database'],
  ['feat.friend.title', 'feat.friend.desc', 'users'],
  ['feat.media.title', 'feat.media.desc', 'image'],
  ['feat.clean.title', 'feat.clean.desc', 'spark'],
  ['feat.platform.title', 'feat.platform.desc', 'monitor'],
  ['feat.language.title', 'feat.language.desc', 'globe'],
] as const;

const flow = [
  ['flow.step1.title', 'flow.step1.desc'],
  ['flow.step2.title', 'flow.step2.desc'],
  ['flow.step3.title', 'flow.step3.desc'],
] as const;

const trustPoints = [
  t('trust.point1'),
  t('trust.point2'),
  t('trust.point3'),
];
---

<section id="features" class="features" aria-labelledby="features-title">
  <div class="site-container">
    <div class="features-header reveal">
      <p class="eyebrow">{t('feat.eyebrow')}</p>
      <h2 id="features-title">{t('feat.title')}</h2>
      <p>{t('feat.sub')}</p>
    </div>

    <div class="feature-grid">
      {features.map(([titleKey, descKey, icon], index) => (
        <article class={`feature-card panel panel--border reveal reveal-delay-${Math.min(index + 1, 3)}`}>
          <div class="feature-icon icon-box" aria-hidden="true">
            {icon === 'database' && (
              <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3" />
                <path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5" />
                <path d="M3 12c0 1.7 4 3 9 3s9-1.3 9-3" />
              </svg>
            )}
            {icon === 'users' && (
              <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            )}
            {icon === 'image' && (
              <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2" />
                <circle cx="9" cy="9" r="2" />
                <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" />
              </svg>
            )}
            {icon === 'spark' && (
              <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6Z" />
                <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8Z" />
              </svg>
            )}
            {icon === 'monitor' && (
              <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="3" rx="2" />
                <path d="M8 21h8" />
                <path d="M12 17v4" />
              </svg>
            )}
            {icon === 'globe' && (
              <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a14 14 0 0 0 0 20 14 14 0 0 0 0-20" />
                <path d="M2 12h20" />
              </svg>
            )}
          </div>
          <h3>{t(titleKey)}</h3>
          <p>{t(descKey)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="flow-section" aria-labelledby="flow-title">
  <div class="site-container flow-layout">
    <div class="flow-copy reveal">
      <p class="eyebrow">{t('flow.eyebrow')}</p>
      <h2 id="flow-title">{t('flow.title')}</h2>
    </div>
    <div class="flow-steps">
      {flow.map(([titleKey, descKey], index) => (
        <article class="flow-step panel panel--border reveal">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{t(titleKey)}</h3>
          <p>{t(descKey)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="trust-section" aria-labelledby="trust-title">
  <div class="site-container trust-layout">
    <div class="trust-card panel panel--elevated reveal">
      <p class="eyebrow">{t('trust.eyebrow')}</p>
      <h2 id="trust-title">{t('trust.title')}</h2>
      <p>{t('trust.desc')}</p>
    </div>
    <ul class="trust-list reveal reveal-delay-1">
      {trustPoints.map((point) => (
        <li>
          <svg class="icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features,
  .flow-section,
  .trust-section {
    padding: var(--space-16) 0;
    background: var(--color-neutral-0);
  }

  .flow-section {
    background: var(--color-neutral-50);
  }

  .features-header {
    max-width: var(--measure-hero);
    margin-bottom: var(--space-12);
  }

  .features-header h2,
  .flow-copy h2,
  .trust-card h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .features-header p:not(.eyebrow),
  .flow-copy p:not(.eyebrow),
  .trust-card p:not(.eyebrow) {
    font-size: var(--text-base);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .feature-card {
    position: relative;
    padding: var(--space-6);
    min-height: 100%;
    overflow: hidden;
    transition: transform var(--motion-base) ease, border-color var(--motion-base) ease, background-color var(--motion-base) ease;
  }

  .feature-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--space-6);
    right: var(--space-6);
    height: var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-1)));
    transition: opacity var(--motion-base) ease, transform var(--motion-base) ease;
  }

  .feature-card:hover {
    transform: translateY(calc(-1 * var(--space-1)));
    border-color: var(--color-neutral-300);
    background: var(--color-neutral-50);
  }

  .feature-card:hover::before {
    opacity: 1;
    transform: translateY(0);
  }

  .feature-icon {
    margin-bottom: var(--space-6);
    transition: transform var(--motion-base) ease, color var(--motion-base) ease;
  }

  .feature-card:hover .feature-icon {
    transform: translateY(calc(-1 * var(--space-1)));
  }

  .feature-card h3,
  .flow-step h3 {
    display: block;
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .feature-card p,
  .flow-step p,
  .trust-list {
    display: block;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .flow-layout,
  .trust-layout {
    display: grid;
    grid-template-columns: minmax(var(--layout-column-min), 0.72fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .flow-copy {
    position: sticky;
    top: calc(var(--layout-header) + var(--space-8));
  }

  .flow-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .flow-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--space-12) minmax(0, 1fr);
    column-gap: var(--space-6);
    row-gap: var(--space-2);
    padding: var(--space-6);
    transition: transform var(--motion-base) ease, border-color var(--motion-base) ease, background-color var(--motion-base) ease;
  }

  .flow-step:hover {
    transform: translateX(var(--space-1));
    border-color: var(--color-neutral-300);
    background: var(--color-neutral-0);
  }

  .flow-step span {
    grid-row: span 2;
    color: var(--color-primary);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    transition: transform var(--motion-base) ease;
  }

  .flow-step:hover span {
    transform: translateY(calc(-1 * var(--space-1)));
  }

  .trust-card {
    padding: var(--space-8);
  }

  .trust-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    list-style: none;
  }

  .trust-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: var(--border-base);
    border-radius: var(--radius-md);
    background: var(--color-neutral-0);
    color: var(--color-text-secondary);
    transition: transform var(--motion-base) ease, border-color var(--motion-base) ease, background-color var(--motion-base) ease;
  }

  .trust-list li:hover {
    transform: translateY(calc(-1 * var(--space-1)));
    border-color: var(--color-neutral-300);
    background: var(--color-neutral-50);
  }

  .trust-list svg {
    color: var(--color-primary);
    margin-top: var(--space-1);
  }

  @media (max-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .features,
    .flow-section,
    .trust-section {
      padding: var(--space-12) 0;
    }

    .feature-grid,
    .flow-layout,
    .trust-layout {
      grid-template-columns: 1fr;
    }

    .flow-copy {
      position: static;
    }
  }
</style>
