---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    number: '01',
    title: t('feat.zero.title'),
    desc: t('feat.zero.desc'),
    icon: 'archive',
  },
  {
    number: '02',
    title: t('feat.e2ee.title'),
    desc: t('feat.e2ee.desc'),
    icon: 'lock',
  },
  {
    number: '03',
    title: t('feat.friend.title'),
    desc: t('feat.friend.desc'),
    icon: 'users',
  },
];
---

<section id="features" class="features">
  <div class="site-container">
    <div class="features-layout">
      <div class="features-header">
        <p class="eyebrow">{t('feat.eyebrow')}</p>
        <h2>{t('feat.title')}</h2>
        <p>{t('feat.sub')}</p>
      </div>

      <div class="feature-list">
        {features.map((feature) => (
          <article class="feature-card panel panel--border">
            <div class="feature-number">{feature.number}</div>
            <div class="icon-box" aria-hidden="true">
              {feature.icon === 'archive' && (
                <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 8v13H3V8" />
                  <path d="M1 3h22v5H1z" />
                  <path d="M10 12h4" />
                </svg>
              )}
              {feature.icon === 'lock' && (
                <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
              )}
              {feature.icon === 'users' && (
                <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              )}
            </div>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding: var(--space-16) 0;
    background: var(--color-neutral-0);
  }

  .features-layout {
    display: grid;
    grid-template-columns: minmax(var(--layout-column-min), 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-16);
    align-items: start;
  }

  .features-header {
    position: sticky;
    top: calc(var(--layout-header) + var(--space-8));
  }

  .features-header h2 {
    max-width: var(--measure-section);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .features-header p:not(.eyebrow) {
    max-width: var(--measure-section);
    font-size: var(--text-base);
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .feature-card {
    display: grid;
    grid-template-columns: var(--space-12) var(--space-12) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    padding: var(--space-8);
    background: var(--color-neutral-0);
  }

  .feature-number {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.25;
  }

  .feature-card h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .feature-card p {
    font-size: var(--text-sm);
  }

  @media (max-width: 768px) {
    .features-layout,
    .feature-card {
      grid-template-columns: 1fr;
    }

    .features-header {
      position: static;
    }
  }
</style>
