---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const downloadUrl = 'https://manhattancafe.online/api/admin/download/latest';
---

<main class="page">
  <div class="content-container">
    <header class="page-header download-header">
      <p class="eyebrow">{t('dl.eyebrow')}</p>
      <h1 class="page-title">{t('dl.title')}</h1>
      <p class="page-subtitle">{t('dl.sub')}</p>
    </header>

    <section class="download-panel panel panel--elevated" aria-labelledby="download-client">
      <div class="download-product">
        <span class="icon-box" aria-hidden="true">
          <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="M7 10l5 5 5-5" />
            <path d="M12 15V3" />
          </svg>
        </span>
        <div>
          <h2 id="download-client">{t('dl.win.desc')}</h2>
          <p>{t('dl.win.meta')}</p>
        </div>
      </div>
      <a href={downloadUrl} class="button button--primary">{t('dl.btn')}</a>
    </section>

    <div class="download-grid">
      <section class="panel panel--border download-section" aria-labelledby="install-steps">
        <h3 id="install-steps" class="section-title">
          <span class="section-marker" aria-hidden="true"></span>
          {t('dl.steps.title')}
        </h3>
        <ol class="step-list">
          <li>
            <span class="step-number">1</span>
            <p><strong>{t('dl.step1.title')}</strong>{t('dl.step1.desc')}</p>
          </li>
          <li>
            <span class="step-number">2</span>
            <p><strong>{t('dl.step2.title')}</strong>{t('dl.step2.desc')}</p>
          </li>
          <li>
            <span class="step-number">3</span>
            <p><strong>{t('dl.step3.title')}</strong>{t('dl.step3.desc')}</p>
          </li>
        </ol>
      </section>

      <section class="panel panel--border download-section" aria-labelledby="security-notes">
        <h3 id="security-notes" class="section-title">
          <span class="section-marker" aria-hidden="true"></span>
          {t('dl.security.title')}
        </h3>
        <p class="security-note">{t('dl.security.note')}</p>
        <a href="mailto:support@prochat.cc" class="text-link support-link">support@prochat.cc</a>
      </section>
    </div>
  </div>
</main>

<style>
  .download-header {
    text-align: center;
  }

  .download-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-8);
    margin-bottom: var(--space-12);
    background: var(--color-neutral-0);
    flex-wrap: wrap;
  }

  .download-product {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .download-product h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .download-product p {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .download-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(var(--layout-column-min), 0.75fr);
    gap: var(--space-8);
    align-items: start;
  }

  .download-section {
    padding: var(--space-8);
  }

  .step-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    list-style: none;
  }

  .step-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-6);
    height: var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-neutral-0);
    font-size: var(--text-xs);
    font-weight: 600;
    flex: 0 0 var(--space-6);
  }

  .step-list p,
  .security-note,
  .support-link {
    font-size: var(--text-sm);
  }

  .step-list strong {
    display: block;
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .security-note {
    margin-bottom: var(--space-4);
  }

  .support-link {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .download-grid {
      grid-template-columns: 1fr;
    }

    .download-product {
      align-items: flex-start;
    }
  }
</style>
