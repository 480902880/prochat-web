---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const downloadUrl = 'https://manhattancafe.online/api/admin/download/latest';

const trustItems = [
  t('dl.trust.official'),
  t('dl.trust.windows'),
  t('dl.trust.local'),
];
---

<main class="page">
  <div class="content-container">
    <header class="page-header download-header">
      <p class="eyebrow">{t('dl.eyebrow')}</p>
      <h1 class="page-title">{t('dl.title')}</h1>
      <p class="page-subtitle">{t('dl.sub')}</p>
    </header>

    <section class="download-hero panel panel--elevated" aria-labelledby="download-client">
      <div class="download-product">
        <span class="icon-box" aria-hidden="true">
          <svg class="icon-standalone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="M7 10l5 5 5-5" />
            <path d="M12 15V3" />
          </svg>
        </span>
        <div>
          <p class="download-kicker">{t('dl.package')}</p>
          <h2 id="download-client">{t('dl.win.desc')}</h2>
          <p>{t('dl.win.meta')}</p>
        </div>
      </div>
      <div class="download-action">
        <a href={downloadUrl} class="button button--primary">{t('dl.btn')}</a>
        <p>{t('dl.action.note')}</p>
      </div>
    </section>

    <div class="download-grid">
      <section class="panel panel--border download-section" aria-labelledby="install-steps">
        <h3 id="install-steps" class="section-title">
          <span class="section-marker" aria-hidden="true"></span>
          {t('dl.steps.title')}
        </h3>
        <ol class="step-list">
          <li>
            <span class="step-number">1</span>
            <div>
              <h4>{t('dl.step1.title')}</h4>
              <p>{t('dl.step1.desc')}</p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h4>{t('dl.step2.title')}</h4>
              <p>{t('dl.step2.desc')}</p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h4>{t('dl.step3.title')}</h4>
              <p>{t('dl.step3.desc')}</p>
            </div>
          </li>
        </ol>
      </section>

      <aside class="download-aside">
        <section class="panel panel--border download-section" aria-labelledby="security-notes">
          <h3 id="security-notes" class="section-title">
            <span class="section-marker" aria-hidden="true"></span>
            {t('dl.security.title')}
          </h3>
          <div class="notice">
            <div class="notice-title">
              <svg class="icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v4" />
                <path d="M12 16h.01" />
              </svg>
              {t('dl.security.important')}
            </div>
            <p>{t('dl.security.note')}</p>
          </div>
          <ul class="security-list">
            <li>{t('dl.security.item1')}</li>
            <li>{t('dl.security.item2')}</li>
            <li>{t('dl.security.item3')}</li>
          </ul>
        </section>

        <section class="panel panel--border trust-section" aria-label={t('dl.trust.label')}>
          {trustItems.map((item) => (
            <div class="trust-item">
              <svg class="icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span>{item}</span>
            </div>
          ))}
        </section>
      </aside>
    </div>
  </div>
</main>

<style>
  .download-header {
    text-align: center;
  }

  .download-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-8);
    margin-bottom: var(--space-12);
    background: var(--color-neutral-0);
    flex-wrap: wrap;
  }

  .download-product {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .download-kicker {
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .download-product h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .download-product p:not(.download-kicker),
  .download-action p {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .download-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .download-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(var(--layout-column-min), 0.8fr);
    gap: var(--space-8);
    align-items: start;
  }

  .download-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .download-section,
  .trust-section {
    padding: var(--space-8);
  }

  .step-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    list-style: none;
  }

  .step-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-6);
    height: var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-neutral-0);
    font-size: var(--text-xs);
    font-weight: 600;
    flex: 0 0 var(--space-6);
  }

  .step-list h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .step-list p,
  .security-list,
  .notice p {
    font-size: var(--text-sm);
  }

  .notice {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-neutral-50);
    margin-bottom: var(--space-4);
  }

  .notice-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .security-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: var(--space-6);
    color: var(--color-text-secondary);
  }

  .trust-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--color-neutral-50);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .trust-item svg {
    color: var(--color-primary);
    margin-top: var(--space-1);
  }

  @media (max-width: 768px) {
    .download-grid {
      grid-template-columns: 1fr;
    }

    .download-product {
      align-items: flex-start;
    }
  }
</style>
