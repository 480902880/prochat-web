---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const mobileFeatures = [
  ['feat.local.title', 'feat.local.desc'],
  ['feat.media.title', 'feat.media.desc'],
  ['feat.clean.title', 'feat.clean.desc'],
] as const;
---

<section class="mobile-landing reveal" aria-labelledby="mobile-hero-title">
  <div class="mobile-shell">
    <p class="mobile-label">{t('hero.label')}</p>
    <h1 id="mobile-hero-title">
      <span>{t('hero.title.primary')}</span>
      <span>{t('hero.title.accent')}</span>
    </h1>
    <p class="mobile-desc">{t('hero.desc')}</p>
    <a href={translatePath('/download')} class="button button--primary">{t('hero.cta')}</a>

    <div class="mobile-chat panel panel--elevated reveal reveal-delay-1" aria-label={t('hero.preview.label')}>
      <div class="mobile-chat-header">
        <div class="mobile-avatar">C</div>
        <div>
          <strong>{t('mock.user')}</strong>
          <span>{t('mock.status')}</span>
        </div>
      </div>
      <p class="mobile-bubble mobile-bubble--in">{t('mock.msg1')}</p>
      <p class="mobile-bubble mobile-bubble--out">{t('mock.msg2')}</p>
      <div class="mobile-input">{t('mock.input')}</div>
    </div>
  </div>
</section>

<section id="mobile-features" class="mobile-features reveal reveal-delay-2">
  <div class="mobile-shell">
    <p class="eyebrow">{t('feat.eyebrow')}</p>
    <h2>{t('feat.title')}</h2>
    <div class="mobile-feature-list">
      {mobileFeatures.map(([titleKey, descKey]) => (
        <article class="panel panel--border mobile-feature-card">
          <h3>{t(titleKey)}</h3>
          <p>{t(descKey)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .mobile-landing,
  .mobile-features {
    background: var(--color-neutral-50);
    padding: calc(var(--layout-header) + var(--space-8)) 0 var(--space-12);
  }

  .mobile-features {
    padding-top: var(--space-12);
    background: var(--color-neutral-0);
  }

  .mobile-shell {
    width: 100%;
    max-width: 448px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .mobile-label {
    display: inline-flex;
    padding: var(--space-1) var(--space-3);
    border: var(--border-base);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-0);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: var(--space-4);
    animation: pulse-border var(--motion-loop) ease-in-out infinite;
  }

  .mobile-landing h1 {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .mobile-landing h1 span:last-child {
    color: var(--color-primary);
  }

  .mobile-desc {
    font-size: var(--text-base);
    margin-bottom: var(--space-6);
  }

  .mobile-chat {
    position: relative;
    padding: var(--space-6);
    margin-top: var(--space-8);
    overflow: hidden;
    animation: quiet-float var(--motion-loop) ease-in-out infinite;
  }

  .mobile-chat::before {
    content: "";
    position: absolute;
    inset: 0;
    border-top: var(--space-1) solid var(--color-primary);
    pointer-events: none;
  }

  .mobile-chat-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: var(--border-base);
  }

  .mobile-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12);
    height: var(--space-12);
    border-radius: var(--radius-md);
    background: var(--color-neutral-100);
    color: var(--color-primary);
    font-weight: 600;
    animation: mobile-avatar var(--motion-loop) ease-in-out infinite;
  }

  .mobile-chat-header strong {
    display: block;
    font-size: var(--text-sm);
  }

  .mobile-chat-header span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .mobile-chat-header span::before {
    content: "";
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-success);
    animation: status-pulse var(--motion-loop) ease-in-out infinite;
  }

  .mobile-bubble {
    max-width: 92%;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
    animation: message-in var(--motion-slow) ease both;
  }

  .mobile-bubble--in {
    background: var(--color-neutral-50);
    color: var(--color-text-secondary);
  }

  .mobile-bubble--out {
    margin-left: auto;
    background: var(--color-primary);
    color: var(--color-neutral-0);
    animation-delay: var(--motion-stagger-1);
  }

  .mobile-input {
    padding: var(--space-3);
    border: var(--border-base);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    animation: pulse-border var(--motion-loop) ease-in-out infinite;
  }

  .mobile-features h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .mobile-feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mobile-feature-card {
    position: relative;
    padding: var(--space-6);
    overflow: hidden;
    transition: transform var(--motion-base) ease, border-color var(--motion-base) ease, background-color var(--motion-base) ease;
  }

  .mobile-feature-card::before {
    content: "";
    position: absolute;
    top: var(--space-6);
    bottom: var(--space-6);
    left: 0;
    width: var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    opacity: 0;
    transition: opacity var(--motion-base) ease;
  }

  .mobile-feature-card:hover,
  .mobile-feature-card:focus-within {
    transform: translateY(calc(-1 * var(--space-1)));
    border-color: var(--color-neutral-300);
    background: var(--color-neutral-50);
  }

  .mobile-feature-card:hover::before,
  .mobile-feature-card:focus-within::before {
    opacity: 1;
  }

  .mobile-feature-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .mobile-feature-card p {
    font-size: var(--text-sm);
  }

  @keyframes mobile-avatar {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }
</style>
