---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="hero">
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <p class="hero-label">{t('hero.label')}</p>
      <h1 class="hero-title">
        <span>{t('hero.title.primary')}</span>
        <span class="hero-title-accent">{t('hero.title.accent')}</span>
      </h1>
      <p class="hero-desc">{t('hero.desc')}</p>
      <div class="hero-actions">
        <a href={translatePath('/download')} class="button button--primary">{t('hero.cta')}</a>
        <a href="#features" class="button button--secondary">{t('hero.more')}</a>
      </div>
    </div>

    <div class="mockup panel panel--elevated" aria-label="ProChat secure chat preview">
      <div class="mockup-header">
        <div class="mockup-user">
          <div class="mockup-avatar">P</div>
          <div>
            <div class="mockup-name">{t('mock.user')}</div>
            <div class="mockup-status">{t('mock.status')}</div>
          </div>
        </div>
        <svg class="icon-standalone mockup-lock" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      </div>

      <div class="message-list">
        <div class="message message--in">{t('mock.msg1')}</div>
        <div class="message message--out">{t('mock.msg2')}</div>
        <div class="message message--pending">...</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--layout-header) + var(--space-16)) 0 var(--space-16);
    background: var(--color-neutral-50);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--layout-column-min), 1fr));
    align-items: center;
    gap: var(--space-16);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .hero-label {
    display: inline-flex;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-0);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-2xl);
  }

  .hero-title-accent {
    color: var(--color-primary);
  }

  .hero-desc {
    max-width: var(--layout-column-min);
    font-size: var(--text-base);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .mockup {
    padding: var(--space-6);
  }

  .mockup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: var(--border-base);
  }

  .mockup-user {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mockup-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12);
    height: var(--space-12);
    border-radius: var(--radius-md);
    background: var(--color-neutral-100);
    color: var(--color-primary);
    font-weight: 600;
  }

  .mockup-name {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .mockup-status {
    color: var(--color-primary);
    font-size: var(--text-xs);
  }

  .mockup-lock {
    color: var(--color-text-tertiary);
  }

  .message-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .message {
    max-width: 80%;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .message--in,
  .message--pending {
    align-self: flex-start;
    background: var(--color-neutral-50);
    color: var(--color-text-secondary);
  }

  .message--out {
    align-self: flex-end;
    background: var(--color-primary);
    color: var(--color-neutral-0);
  }

  .message--pending {
    max-width: 50%;
    color: var(--color-text-tertiary);
  }
</style>
