---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const proofItems = [
  t('hero.proof.server'),
  t('hero.proof.local'),
  t('hero.proof.transport'),
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="site-container hero-grid">
    <div class="hero-copy reveal">
      <p class="hero-label">{t('hero.label')}</p>
      <h1 id="hero-title" class="hero-title">
        <span>{t('hero.title.primary')}</span>
        <span class="hero-title-accent">{t('hero.title.accent')}</span>
      </h1>
      <p class="hero-desc">{t('hero.desc')}</p>
      <div class="hero-actions">
        <a href={translatePath('/download')} class="button button--primary">{t('hero.cta')}</a>
        <a href="#features" class="button button--secondary">{t('hero.more')}</a>
      </div>
      <div class="proof-strip" aria-label={t('hero.proof.label')}>
        {proofItems.map((item) => (
          <span>
            <svg class="icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {item}
          </span>
        ))}
      </div>
    </div>

    <div class="chat-stage reveal reveal-delay-1" aria-label={t('hero.preview.label')}>
      <div class="chat-shell panel panel--elevated">
        <div class="chat-topbar">
          <div class="chat-person">
            <div class="chat-avatar">C</div>
            <div>
              <div class="chat-name">{t('mock.user')}</div>
              <div class="chat-status">
                <span aria-hidden="true"></span>
                {t('mock.status')}
              </div>
            </div>
          </div>
          <svg class="icon-standalone chat-lock" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>

        <div class="chat-messages">
          <p class="bubble bubble--in">{t('mock.msg1')}</p>
          <p class="bubble bubble--out">{t('mock.msg2')}</p>
          <p class="bubble bubble--in bubble--last">{t('mock.msg3')}</p>
        </div>

        <div class="chat-meta">
          <span>{t('mock.meta.route')}</span>
          <span>{t('mock.meta.state')}</span>
        </div>

        <div class="chat-input">
          <span>{t('mock.input')}</span>
          <svg class="icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: calc(var(--layout-header) + var(--space-16)) 0 var(--space-16);
    background: var(--color-neutral-50);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(var(--layout-column-min), 0.86fr);
    align-items: center;
    gap: var(--space-16);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    max-width: var(--measure-hero);
  }

  .hero-label {
    display: inline-flex;
    padding: var(--space-1) var(--space-3);
    border: var(--border-base);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-0);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--measure-heading);
    font-size: var(--text-2xl);
  }

  .hero-title-accent {
    color: var(--color-primary);
  }

  .hero-desc {
    max-width: var(--measure-heading);
    font-size: var(--text-base);
  }

  .hero-actions,
  .proof-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .proof-strip {
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .proof-strip span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: var(--border-base);
    border-radius: var(--radius-md);
    background: var(--color-neutral-0);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .proof-strip svg {
    color: var(--color-primary);
  }

  .chat-stage {
    position: relative;
  }

  .chat-stage::before,
  .chat-stage::after {
    content: "";
    position: absolute;
    border: var(--border-base);
    border-radius: var(--radius-md);
    background: var(--color-neutral-0);
    pointer-events: none;
  }

  .chat-stage::before {
    inset: var(--space-8) calc(-1 * var(--space-4)) calc(-1 * var(--space-4)) var(--space-8);
  }

  .chat-stage::after {
    inset: calc(-1 * var(--space-4)) var(--space-8) var(--space-8) calc(-1 * var(--space-4));
  }

  .chat-shell {
    position: relative;
    z-index: 1;
    padding: var(--space-6);
    overflow: hidden;
  }

  .chat-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    border-top: var(--space-1) solid var(--color-primary);
    pointer-events: none;
  }

  .chat-topbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: var(--border-base);
  }

  .chat-person {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .chat-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12);
    height: var(--space-12);
    border-radius: var(--radius-md);
    background: var(--color-neutral-100);
    color: var(--color-primary);
    font-weight: 600;
  }

  .chat-name {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .chat-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .chat-status span {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-success);
    animation: status-pulse var(--motion-slow) ease-in-out infinite;
  }

  .chat-lock {
    color: var(--color-primary);
  }

  .chat-messages {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bubble {
    max-width: 82%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    animation: message-in var(--motion-slow) ease both;
  }

  .bubble--in {
    align-self: flex-start;
    background: var(--color-neutral-50);
    color: var(--color-text-secondary);
  }

  .bubble--out {
    align-self: flex-end;
    background: var(--color-primary);
    color: var(--color-neutral-0);
    animation-delay: 180ms;
  }

  .bubble--last {
    animation-delay: 320ms;
  }

  .chat-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .chat-meta span,
  .chat-input {
    border: var(--border-base);
    border-radius: var(--radius-md);
    background: var(--color-neutral-0);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .chat-meta span {
    padding: var(--space-3);
  }

  .chat-input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--space-12);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-4);
    animation: pulse-border 2800ms ease-in-out infinite;
  }

  .chat-input svg {
    color: var(--color-primary);
  }

  @keyframes status-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.82);
    }
  }

  @keyframes message-in {
    from {
      opacity: 0;
      transform: translateY(var(--space-3));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      gap: var(--space-12);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--layout-header) + var(--space-12));
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .hero-actions {
      width: 100%;
    }

    .chat-stage::before,
    .chat-stage::after {
      display: none;
    }
  }
</style>
