---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import MobileHome from '../../components/MobileHome.astro';
import Footer from '../../components/Footer.astro';
import WebsiteAnnouncement from '../../components/WebsiteAnnouncement.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('meta.home.title')} description={t('meta.home.description')} path="/en/" pageType="home">
  <Header />
  <main id="content">
    <WebsiteAnnouncement lang={lang} />
    <div class="desktop-home">
      <Hero />
      <Features />
    </div>
    <div class="mobile-home">
      <MobileHome />
    </div>
  </main>
  <Footer />
</Layout>
